# Copy to .env and fill in. Values here are read by app/config.py (pydantic-settings).

# --- Providers (a provider is only registered when it's usable) ---
# Kokoro: local CPU model, no key. Needs the "local" extra (uv sync --extra local).
KOKORO_ENABLED=true
KOKORO_VOICE=af_heart

# Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Engine defaults ---
# Code default is kokoro/af_heart. For Gemini use e.g. DEFAULT_PROVIDER=gemini, DEFAULT_VOICE=Kore.
DEFAULT_PROVIDER=kokoro
DEFAULT_VOICE=af_heart

# --- Podcast output + job store ---
OUTPUT_DIR=./output
JOBS_DB=./output/jobs.db
PODCAST_PAUSE_MS=600
