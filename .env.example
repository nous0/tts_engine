# Copy to .env and fill in. Values here are read by app/config.py (pydantic-settings).

# --- Providers (a provider is only registered when it's usable) ---
# Kokoro: local CPU model, no key. Needs the "local" extra (uv sync --extra local).
KOKORO_ENABLED=true
KOKORO_VOICE=af_heart
# How many Kokoro syntheses run at once (each already uses every CPU core).
KOKORO_MAX_CONCURRENCY=1
# Load the model in the background at startup (/health shows loading -> ready).
KOKORO_PRELOAD=true
# torch threads for Kokoro; fewer than torch's default is faster (4 measured best on a
# 16-thread CPU). 0 keeps torch's default.
KOKORO_TORCH_THREADS=4

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=alloy
# Per-attempt timeout (s) and SDK retries on network/429/5xx errors.
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2

# --- Engine defaults ---
# Code default is kokoro/af_heart. For OpenAI use e.g. DEFAULT_PROVIDER=openai, DEFAULT_VOICE=alloy.
DEFAULT_PROVIDER=kokoro
DEFAULT_VOICE=af_heart

# --- Podcast output + job store ---
OUTPUT_DIR=./output
JOBS_DB=./output/jobs.db
# Episode loudness (EBU R128 via ffmpeg). -19 LUFS for mono speech = -16 LUFS stereo.
PODCAST_TARGET_LUFS=-19
# mp3 episodes: bitrate and sample rate (44.1 kHz for podcast platforms).
PODCAST_MP3_BITRATE=64k
PODCAST_MP3_SAMPLE_RATE=44100
# Podcast scripts from a topic: auto (OpenAI when a key is set), openai, fake, off.
SCRIPT_WRITER=auto
SCRIPT_MODEL=gpt-4o-mini
SCRIPT_TIMEOUT=120
# Longer turns are split at sentences (OpenAI TTS takes at most 4096 characters).
SCRIPT_MAX_TURN_CHARS=1500
MAX_CONCURRENT_SCRIPT_JOBS=4
# Podcast renders that run at once; the rest wait as "queued".
MAX_CONCURRENT_JOBS=1
# Finished jobs and their audio files older than this are deleted (0 keeps all).
JOBS_RETENTION_DAYS=7

# --- Audio cache (one-shot speech, podcast turns, and each pcm/wav stream sentence) ---
CACHE_ENABLED=true
CACHE_DIR=./output/cache
CACHE_MAX_MB=512

# Streamed pcm/wav: trim each chunk's edge silence and add natural pauses between chunks.
STREAM_SHAPE_AUDIO=true

# --- WebSocket /v1/speech/ws ---
# Browser origins allowed to connect, comma-separated (e.g. http://localhost:7860).
# Server-side clients (no Origin header) are always allowed.
WS_ALLOWED_ORIGINS=
WS_MAX_TURN_CHARS=10000

# --- Logging (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO
